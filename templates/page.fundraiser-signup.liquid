{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Fundraiser Request</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6fc;
      margin: 0;
      padding: 0;
    }
    .form-wrapper {
      display: flex;
      min-height: 100vh;
    }
    .left {
      width: 40%;
      background: #134c99;
      color: white;
      padding: 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .left img {
      width: 100px;
      margin-bottom: 20px;
    }
    .right {
      width: 60%;
      padding: 40px;
      background: white;
    }
    .form-step {
      display: none;
    }
    .form-step.active {
      display: block;
    }
    input, textarea, select {
      display: block;
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border-radius: 4px;
      border: 1px solid #ccc;
    }
    .btn {
      background: #f57c00;
      color: white;
      padding: 12px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .btn:disabled {
      background: #ccc;
    }
    label {
      font-weight: bold;
    }
    .checkbox-group {
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <div class="form-wrapper">
    <!-- LEFT COLUMN -->
    <div class="left">
      <img src="{{ 'logo.png' | asset_url }}" alt="Logo">
      <h2>Smarter school fundraising, made simple</h2>
      <p>Create your account and unlock all the tools you need to manage, track, and grow your school fundraiser.</p>
      <img src="{{ 'piggy.png' | asset_url }}" alt="Mascot" style="width:150px;">
    </div>

    <!-- RIGHT COLUMN -->
    <div class="right">
      <form id="fundraiser-form">
        <!-- STEP 1 -->
        <div class="form-step step-1 active">
          <h3>Fundraiser Account Request</h3>
          <label>Name*</label>
          <input type="text" name="name" required>
          
          <label>Phone Number*</label>
          <input type="tel" name="phone" required>

          <label>Email*</label>
          <input type="email" name="email" required>

          <label>School Address*</label>
          <input type="text" name="street1" placeholder="Street 1" required>
          <input type="text" name="street2" placeholder="Street 2">
          <input type="text" name="city" placeholder="City" required>
          <input type="text" name="state" placeholder="State" required>
          <input type="text" name="zip" placeholder="Zip" required>

          <button type="button" class="btn" id="next-btn">Continue</button>
        </div>

        <!-- STEP 2 -->
        <div class="form-step step-2">
          <h3>Fundraiser Details</h3>
          <label>Fundraiser Goal*</label>
          <input type="text" name="goal" required>

          <label>School/Group Name*</label>
          <input type="text" name="group" required>

          <label>Payment Method*</label>
          <select name="payment_method" required>
            <option value="ACH">ACH</option>
            <option value="Check">Check</option>
          </select>

          <label>Additional Comments</label>
          <textarea name="comments"></textarea>

          <div class="checkbox-group">
            <label>
              <input type="checkbox" name="terms" required>
              I agree to the Terms and Conditions*
            </label><br>
            <label>
              <input type="checkbox" name="marketing" checked>
              I would like to receive marketing emails
            </label>
          </div>

          <button type="submit" class="btn">Submit</button>
        </div>
      </form>
      <div id="form-message" style="margin-top: 20px;"></div>
    </div>
  </div>

  <script>
    const nextBtn = document.getElementById('next-btn');
    const form = document.getElementById('fundraiser-form');
    const formMessage = document.getElementById('form-message');

    nextBtn.addEventListener('click', () => {
      document.querySelector('.step-1').classList.remove('active');
      document.querySelector('.step-2').classList.add('active');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        // Replace with your Formspree or EmailJS endpoint
        const response = await fetch('https://formspree.io/f/your_form_id', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData
        });

        if (response.ok) {
          formMessage.textContent = "Form submitted successfully! 🎉";
          form.reset();
        } else {
          formMessage.textContent = "There was an error submitting the form.";
        }
      } catch (error) {
        formMessage.textContent = "Something went wrong. Try again later.";
      }
    });
  </script>
</body>
</html>

{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.17/css/intlTelInput.min.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.17/js/intlTelInput.min.js"></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.17/js/utils.js"></script>


  <title>Fundraiser Request</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6fc;
      margin: 0;
      padding: 0;
    }
    .form-wrapper {
      display: flex;
      min-height: 100vh;
    }
    .left {
      width: 30%;
      background: #2877C2;
      color: white;
      padding: 40px;
      padding-top: 100px;
      padding-bottom: 100px; 
      display: flex;
      flex-direction: column;
      align-items: left;
      justify-content: space-between;
    }

    .left-header{
      max-width: 500px;
    }
    .left-header h2{
      font-family: 'Poppins', sans-serif;
      font-size: 32px;
    }

    .left-header p{
      font-family: 'Roboto', sans-serif;
      font-size: 18px;
      font-weight: 200;
    }

    .signup-image{
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;

    }

    .signup-image img{
      width: 350px;
    }
    
    .right {
      width: 70%;
      padding: 40px;
      background: white;
    }

    #fundraiser-form{
      margin: auto;
      max-width: 1000px;
    }
    
    .form-step {
      display: none;
    }
    .form-header{
      color: #1F2443;
      margin-bottom: 50px;
    }

    .form-header p{
      color: #4E536E;
    }
    .form-step.active {
      display: block;
    }
    .signup-field {
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      background: transparent;
      margin-bottom: 50px;
      padding-top: 20px;
    }

    .signup-label {
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
      font-weight: 500;
      color: #1F2443;
      margin-bottom: 30px;
      padding-bottom: 10px;
    }
    input, textarea, select {
      display: block;
      width: 100%;
      padding: 10px;
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      margin-bottom: 20px;
      padding: 10px 5px;
      background: transparent;
      box-shadow: none;
      font-family: 'Poppins', sans-serif;
    }

    .signup-field:focus {
      border-bottom-color: #134c99;
      outline: none;
    }

    .signup-field input[type="text"]::placeholder{
      border-bottom-color: #999;
      outline: none;
    }
    .btn {
      background: #E1831B;
      color: white;
      padding: 14px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      width: 100%;
      font-size: 16px;
      margin-top: 30px;
    }

    .btn:hover {
        background-color: #e67e00; /* darker orange */
        transition: all 0.25s ease;
    }

    .btn-outline {
      background: white;
      color: #2877C2;
      border: 1px solid #2877C2;
      padding: 12px 20px;
      border-radius: 5px;
      cursor: pointer;
      width: 100%;
      font-size: 16px;
    }
    .btn-outline:hover {
        background-color: #2877C2; /* darker orange */
        color: #ffffff;
        transition: all 0.25s ease;
    }

    .form-buttons{
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-top: 20px;

    }
    .btn:disabled {
      background: #ccc;
    }
    label {
      font-weight: bold;
    }

    #fundraiser-form .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 30px;
      width: 100%;
      max-width: 100%;
      margin-bottom: 0px;
    }

    #fundraiser-form .checkbox-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      font-family: 'Roboto', sans-serif;
      color: #1F2443;
      font-size: 14px;
      line-height: 1.5;
      font-weight: normal;
      
    }

    .checkbox-item p{
      font-weight: 100;
    }

    #fundraiser-form .checkbox-item input[type="checkbox"] {
      margin-top: 4px;
      transform: scale(1.2) !important;
      flex-shrink: 0;
      accent-color: #2877C2; /* Optional: match your brand */
    }

   

    #fundraiser-form .checkbox-item label {
      display: block;
      flex: 1;
      margin: 0;
    }

    #fundraiser-form .link {
      color: #2877C2;
      text-decoration: underline;
    }

    #fundraiser-form .required {
      color: red;
      margin-left: 2px;
    }

    #fundraiser-form input[type="checkbox"] {
      all: unset;
      appearance: checkbox;
      width: 12px;
      height: 12px;
      margin-top: 4px;
      accent-color: #2877C2;
      display: inline-block;
      border-radius: 10px;
    }


    .address-group input[type="text"] {
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      margin-bottom: 20px;
      padding: 10px 5px;
      background: transparent;
      box-shadow: none;
    }

    .address-group input[type="text"]::placeholder {
      color: #999;
    }

    .address-group input[type="text"]:focus {
      border-bottom-color: #134c99;
      outline: none;
    }

    .address-group .form-row {
      display: flex;
      gap: 10px;
    }

    .address-group .form-row input {
      flex: 1;
    }

    /* Thank You Section */
    #thank-you-section {
      display: none;
      background: white;
      width: 100%;
      padding: 40px;
      
      /* Center content */
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100%;
    }

    #thank-you-section .thank-you-message {
      max-width: 600px;
      text-align: center;
    }

    #thank-you-section h1 {
      color: #1F2443;
      font-size: 32px;
      margin-bottom: 20px;
    }

    #thank-you-section p {
      font-size: 18px;
      font-family: 'Roboto', sans-serif;
      line-height: 1.5;
      margin-bottom: 40px;
    }

    #thank-you-section a.home-link {
      font-size: 16px;
      color: #1F2443;
      text-decoration: none;
      font-weight: bold;
    }

    .login-link a {
      color: #E1831B;
      font-weight: bold;
      text-decoration: underline;
    }

    .login-link {
      font-family: 'Roboto', sans-serif;
      font-size: 14px;
      color: #4E536E;

    }
    
    html, body {
      width: 100%;
      overflow-x: hidden;
    }

    @media (max-width: 768px) {
      .form-wrapper {
      flex-direction: column;
    }


    .left, .right {
      width: 95%;
      padding-left: 10px;
      padding-right: 10px;
      padding-bottom: 15px;
      align-items: center;
      text-align: left;
    }


    .left-header h2 {
      font-size: 24px;
    }


    .left-header p {
      font-size: 16px;
    }


    .signup-image img {
      width: 200px;
      margin: 0 auto;
    }


    .right {
      padding: 30px 20px;
    }


    .signup-label {
      text-align: left;
    }


    .form-buttons {
      flex-direction: column;
      width: 100%;
    }


    input, textarea, select {
      font-size: 16px;
      width: 90%;
      }


    .btn, .btn-outline {
      font-size: 16px;
      padding: 14px;
      width: 95%;
    }


    #thank-you-section {
      padding: 40px 20px;
    }


    #thank-you-section .thank-you-message {
      max-width: 100%;
    }
}


  </style>
</head>
<body>

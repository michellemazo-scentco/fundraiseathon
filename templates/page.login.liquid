{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6fc;
      margin: 0;
      padding: 0;
    }
    .form-wrapper {
      display: flex;
      min-height: 100vh;
    }
    .left {
      width: 30%;
      background: #2877C2;
      color: white;
      padding: 40px;
      padding-top: 100px;
      display: flex;
      flex-direction: column;
      align-items: left;
      justify-content: space-between;
    }
    .left-header {
      max-width: 500px;
    }
    .left-header h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 32px;
    }
    .left-header p {
      font-family: 'Roboto', sans-serif;
      font-size: 18px;
      font-weight: 200;
    }
    .signup-image {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
    }
    .signup-image img {
      width: 350px;
    }
    .right {
      width: 60%;
      padding: 80px 40px;
      background: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .login-container {
      max-width: 400px;
      width: 100%;
    }
    .signup-label {
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
      font-weight: 500;
      color: #1F2443;
      margin-bottom: 10px;
      display: block;
    }
    .signup-field {
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      background: transparent;
      width: 100%;
      padding: 10px 5px;
      margin-bottom: 30px;
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
    }
    .btn {
      background: #f57c00;
      color: white;
      padding: 14px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      width: 100%;
      font-size: 16px;
      margin-top: 10px;
    }
    .toggle-password {
        position: absolute;
        right: 10px;
        top: 38px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
    }
    .password-wrapper {
      position: relative;
      width: 100%;
    }
    .signup-link {
      margin-top: 20px;
      text-align: center;
      font-size: 14px;
      font-family: 'Roboto', sans-serif;
      color: #333;
    }
    .signup-link a {
      color: #f57c00;
      font-weight: bold;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="form-wrapper">
    <!-- LEFT COLUMN -->
    <div class="left">
      <a href="/">
        <img src="{{ 'white_logo.png' | file_url }}" alt="Logo" style="width:250px;">
      </a>
      <div class="left-header">
        <h2>Smarter school fundraising, made simple</h2>
        <p>Create your account and unlock all the tools you need to manage, track, and grow your school fundraiser.</p>
      </div>
      <div class="signup-image">
        <img src="{{ 'Piggy.png' | file_url }}" alt="Mascot">
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="right">
      <div class="login-container">
        <h2 style="color: #1F2443; margin-bottom: 30px;">Login</h2>

        <label class="signup-label" for="email">Email*</label>
        <input type="email" class="signup-field" id="email" name="email" placeholder="you@example.com" required>

        <label class="signup-label" for="password">Password*</label>
        <div class="password-wrapper">
          <input type="password" class="signup-field" id="password" name="password" placeholder="Enter your password" required>
          <button id="togglePassword" type="button" class="toggle-password" aria-label="Toggle password visibility">
            <!-- Eye Open SVG (default visible) -->
            <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#666" viewBox="0 0 24 24">
                <path d="M12 5c-7.633 0-10 7-10 7s2.367 7 10 7 10-7 10-7-2.367-7-10-7zm0 12c-2.761 0-5-2.239-5-5s2.239-5 
                5-5 5 2.239 5 5-2.239 5-5 5zm0-8c-1.657 0-3 1.343-3 3s1.343 3 3 3 
                3-1.343 3-3-1.343-3-3-3z"/>
            </svg>

            <!-- Eye Slash (hidden) -->
            <svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#666" viewBox="0 0 24 24" style="display: none;">
                <path d="M2 5.27l2.28 2.28c-1.76 1.4-3.13 3.19-4.28 5.45 
                2.76 5.31 7.41 8 11.99 8 1.93 0 3.79-.47 5.44-1.32l2.3 2.3 
                1.27-1.27L3.27 4 2 5.27zM7.1 9.37l1.49 1.49c-.05.2-.09.41-.09.64 
                0 1.66 1.34 3 3 3 .22 0 .43-.04.64-.09l1.49 1.49c-.64.32-1.35.51-2.13.51-2.21 0-4-1.79-4-4 
                0-.78.19-1.49.51-2.13zm5.9-1.37c2.21 0 4 1.79 4 4 
                0 .78-.19 1.49-.51 2.13l1.5 1.5c.64-.96 1.01-2.1 1.01-3.63 
                0-5.52-4.48-10-10-10-2.5 0-4.77.91-6.54 2.42l1.48 1.48c1.3-1.11 3.01-1.9 5.06-1.9z"/>
            </svg>
        </button>
        </div>

        <button class="btn" type="submit">Log In</button>

        <div class="signup-link">
          Don’t have an account yet? <a href="/pages/fundraiser-request">Sign up</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById("togglePassword");
    const passwordInput = document.getElementById("password");
    const eyeOpen = document.getElementById("eye-open");
    const eyeClosed = document.getElementById("eye-closed");

    toggleBtn.addEventListener("click", function () {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";

        // Toggle icon visibility
        eyeOpen.style.display = isPassword ? "none" : "inline";
        eyeClosed.style.display = isPassword ? "inline" : "none";
    });
</script>
</body>
</html>

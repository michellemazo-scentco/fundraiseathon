{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6fc;
      margin: 0;
      padding: 0;
    }
    .form-wrapper {
      display: flex;
      min-height: 100vh;
    }
    .left {
      width: 30%;
      background: #2877C2;
      color: white;
      padding: 40px;
      padding-top: 100px;
      display: flex;
      flex-direction: column;
      align-items: left;
      justify-content: space-between;
    }
    .left-header {
      max-width: 500px;
    }
    .left-header h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 32px;
    }
    .left-header p {
      font-family: 'Roboto', sans-serif;
      font-size: 18px;
      font-weight: 200;
    }
    .signup-image {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
    }
    .signup-image img {
      width: 350px;
    }
    .right {
      width: 70%;
      padding: 80px 40px;
      background: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .login-container {
      max-width: 400px;
      width: 100%;
    }
    .signup-label {
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
      font-weight: 500;
      color: #1F2443;
      margin-bottom: 10px;
      display: block;
    }
    .signup-field {
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      background: transparent;
      width: 100%;
      padding: 10px 5px;
      margin-bottom: 30px;
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
    }
    .btn {
      background: #f57c00;
      color: white;
      padding: 14px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      width: 100%;
      font-size: 16px;
      margin-top: 10px;
    }
    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-120%);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .password-wrapper {
      position: relative;
      width: 100%;
    } 

    .signup-link {
      margin-top: 20px;
      text-align: center;
      font-size: 14px;
      font-family: 'Roboto', sans-serif;
      color: #4E536E;
    }
    .signup-link a {
      color: #f57c00;
      font-weight: bold;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="form-wrapper">
    <!-- LEFT COLUMN -->
    <div class="left">
      <a href="/">
        <img src="{{ 'white_logo.png' | file_url }}" alt="Logo" style="width:250px;">
      </a>
      <div class="left-header">
        <h2>Smarter school fundraising, made simple</h2>
        <p>Create your account and unlock all the tools you need to manage, track, and grow your school fundraiser.</p>
      </div>
      <div class="signup-image">
        <img src="{{ 'Piggy.png' | file_url }}" alt="Mascot">
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="right">
      <div class="login-container">
        <h2 style="color: #1F2443; margin-bottom: 30px;">Login</h2>

        <label class="signup-label" for="email">Email*</label>
        <input type="email" class="signup-field" id="email" name="email" placeholder="you@example.com" required>
        <label class="signup-label" for="password">Password*</label>
        <div class="password-wrapper">
        <input
            type="password"
            class="signup-field"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
        />

        <button type="button" id="togglePassword" class="toggle-password" aria-label="Toggle password visibility">
            <!-- Eye Open -->
            <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="20" height="20" fill="#666">
            <path d="M320 96C239.2 96 174.5 132.8 127.4 176.6C80.6 220.1 49.3 272 34.4 307.7C31.1 315.6 31.1 324.4 34.4 332.3C49.3 368 80.6 420 127.4 463.4C174.5 507.1 239.2 544 320 544C400.8 544 465.5 507.2 512.6 463.4C559.4 419.9 590.7 368 605.6 332.3C608.9 324.4 608.9 315.6 605.6 307.7C590.7 272 559.4 220 512.6 176.6C465.5 132.9 400.8 96 320 96zM176 320C176 240.5 240.5 176 320 176C399.5 176 464 240.5 464 320C464 399.5 399.5 464 320 464C240.5 464 176 399.5 176 320zM320 256C320 291.3 291.3 320 256 320C244.5 320 233.7 317 224.3 311.6C223.3 322.5 224.2 333.7 227.2 344.8C240.9 396 293.6 426.4 344.8 412.7C396 399 426.4 346.3 412.7 295.1C400.5 249.4 357.2 220.3 311.6 224.3C316.9 233.6 320 244.4 320 256z"/>
            </svg>

            <!-- Eye Closed -->
            <svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="20" height="20" fill="#666" style="display: none;">
            <path d="M73 39.1C63.6 29.7 48.4 29.7 39.1 39.1C29.8 48.5 29.7 63.7 39 73.1L567 601.1C576.4 610.5 591.6 610.5 600.9 601.1C610.2 591.7 610.3 576.5 600.9 567.2L504.5 470.8C507.2 468.4 509.9 466 512.5 463.6C559.3 420.1 590.6 368.2 605.5 332.5C608.8 324.6 608.8 315.8 605.5 307.9C590.6 272.2 559.3 220.2 512.5 176.8C465.4 133.1 400.7 96.2 319.9 96.2C263.1 96.2 214.3 114.4 173.9 140.4L73 39.1zM236.5 202.7C260 185.9 288.9 176 320 176C399.5 176 464 240.5 464 320C464 351.1 454.1 379.9 437.3 403.5L402.6 368.8C415.3 347.4 419.6 321.1 412.7 295.1C399 243.9 346.3 213.5 295.1 227.2C286.5 229.5 278.4 232.9 271.1 237.2L236.4 202.5zM357.3 459.1C345.4 462.3 332.9 464 320 464C240.5 464 176 399.5 176 320C176 307.1 177.7 294.6 180.9 282.7L101.4 203.2C68.8 240 46.4 279 34.5 307.7C31.2 315.6 31.2 324.4 34.5 332.3C49.4 368 80.7 420 127.5 463.4C174.6 507.1 239.3 544 320.1 544C357.4 544 391.3 536.1 421.6 523.4L357.4 459.2z"/>
            </svg>
        </button>
        </div>


        <button class="btn" type="submit">Log In</button>

        <div class="signup-link">
          Don’t have an account yet? <a href="/pages/start-a-fundraiser">Sign up</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById("togglePassword");
    const passwordInput = document.getElementById("password");
    const eyeOpen = document.getElementById("eye-open");
    const eyeClosed = document.getElementById("eye-closed");

    toggleBtn.addEventListener("click", function () {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";

        // Toggle icon visibility
        eyeOpen.style.display = isPassword ? "none" : "inline";
        eyeClosed.style.display = isPassword ? "inline" : "none";
    });
</script>
</body>
</html>

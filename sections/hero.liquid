{% schema %}
{
  "name": "Hero Landing Section",
  "tag": "section",
  "class": "hero-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "School fundraising made simple."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlighted Text",
      "default": "Share, donate, grow"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One dashboard for schools. One app for parents. Simple tracking for every dollar."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Start Fundraising"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Landing Section"
    }
  ]
}
{% endschema %}
<div class="hero-page">
  <div class="hero-landing-container">
    <div class="hero-content hero-left">
      <h1>{{ section.settings.headline }}</h1>
      <div class="highlighted-text-wrapper" id="highlighted-text">
        <span class="highlight-bg"></span>
        <span class="highlight-text">{{ section.settings.highlight_text }}</span>
      </div>
      <p>{{ section.settings.subheading }}</p>

      <!-- Mobile-only pig image -->
      <div class="hero-image-wrapper-mobile">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="Hero Image">
        {% endif %}
      </div>
      <div class="hero-buttons">
        <a href="{{ section.settings.primary_button_url }}" class="btn btn-primary">{{ section.settings.primary_button_text }}</a>
        <a href="{{ section.settings.secondary_button_url }}" class="btn btn-secondary">{{ section.settings.secondary_button_text }}</a>
      </div>
    </div>
    <div class="hero-image-wrapper hero-right">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="Hero Image">
      {% endif %}
    </div>

  </div>
  <div class="hero-bottom-curve">
      <svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,0 C480,120 960,0 1440,120 L1440,0 L0,0 Z" fill="#EAF3FB"/>
      </svg>
  </div>
</div>

<style>
.body {
  background: #ffffff;
}
.hero-page{
  overflow: hidden;
}
.hero-landing-container {
  position: relative;
  background: #EAF3FB;
  display: flex;
  flex-wrap: wrap;
  justify-content: center; /* ✅ Centers both sides horizontally */
  align-items: center;
  gap: 40px; /* ✅ Adds natural space between content and image */
  padding: 80px 5%;
  overflow: visible;
  max-width: 1500px;
  margin: 0 auto;
}

.hero-left {
  flex: 1 1 500px;
  z-index: 2;
  text-align: left;
  margin: 0 auto; /* ✅ Centers horizontally within its flex area */
}

.hero-right {
  flex: 1;
  position: relative;
  right: -100px;
  z-index: 1;
}

.hero-image-wrapper img {
  width: 100%;
  max-height: 500px;
  height: auto;
  max-width: 100%;
  object-fit: contain;
  margin-left: -80px;
}

.hero-image-wrapper {
  position: relative;
  flex: 1;
  z-index: 1;
  margin-left: -80px;
}

/* Gradient background */
.hero-image-wrapper::before {
  content: "";
  position: absolute;
  top: 10%;
  left: -20%;
  width: 140%;
  height: 120%;
  background: radial-gradient(circle at center, #ffdca7 0%, #ffe9c7 50%, transparent 100%);
  z-index: -1;
  border-radius: 50%;
  filter: blur(40px);
}

.hero-content h1 {
  font-family: 'Poppins', sans-serif;
  font-size: 42px;
  font-weight: 800px;
  color: #1F2443;
  margin-bottom: 10px;
}

.highlighted-text-wrapper {
  position: relative;
  display: inline-block;
  font-family: 'Poppins', sans-serif;
  font-size: 42px;
  font-weight: 800px;
  margin-bottom: 20px;
  cursor: pointer;
}

.highlight-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 70%;
  background-image: url('https://cdn.shopify.com/s/files/1/0745/8694/7905/files/Brush_stroke.png?v=1759267393');
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  z-index: 1;


  transform: scaleX(0);
  transform-origin: left;
  animation: highlight-swipe 0.8s ease forwards;
  animation-delay: 0.8s; /* delay after page load */
}

.highlight-text {
  position: relative;
  z-index: 2;
  color: #1F2443;
  animation: text-color 0.8s ease forwards;
  animation-delay: 0.8s;
}

/* Keyframes */
@keyframes highlight-swipe {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes text-color {
  from { color: #1F2443; }
  to { color: #1F2443; }
}


.hero-content p {
  font-size: 20px;
  font-family: 'Roboto', sans-serif;
  color: #1F2443;
  margin-bottom: 30px;
  max-width: 600px;
}

.hero-buttons .btn {
  display: inline-block;
  padding: 10px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-size: 20px;
  margin-right: 15px;
}

.btn-primary {
  background-color: #E1831B;
  color: #fff;
}

.btn-secondary {
  border: 1px solid #2877C2;
  color: #2877C2;
  background: transparent;
}

.hero-bottom-curve {
  width: 100%;
  line-height: 0;
  background: #2877C2;
  position: relative;
  z-index: 0; 
  overflow: visible;
}

.hero-bottom-curve svg {
  display: block;
  width: 100%;
  height: auto;
  z-index: -1; 
}


.btn-primary:hover {
  background-color: #e67e00; /* darker orange */
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  transition: all 0.25s ease;
}

.btn-secondary:hover {
  background-color: #1c75bc;
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  transition: all 0.25s ease;
}

/* Hide the mobile image by default (desktop view) */
.hero-image-wrapper-mobile {
  display: none;
  position: relative; /* needed for the ::before glow */
  z-index: -5;
}

/* Keep the desktop pig sizing stable */
.hero-image-wrapper img {
  max-width: 100%;
  max-height: 500px;
  width: auto;
  height: auto;
  object-fit: contain;
}
.hero-image-wrapper-mobile::before {
  content: "";
  position: absolute;
  top: 10%;
  left: 50%;
  transform: translateX(-50%);
  width: 180%;
  height: 180%;
  background: radial-gradient(circle at center, #ffdca7 0%, #ffe9c7 50%, transparent 100%);
  z-index: -1;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.8;
}

@keyframes glow-pulse {
  0% {
    opacity: 0.8;
    transform: translateX(-50%) scale(1);
    filter: blur(100px);
  }
  50% {
    opacity: 1;
    transform: translateX(-50%) scale(1.1);
    filter: blur(60px);
  }
  100% {
    opacity: 0.8;
    transform: translateX(-50%) scale(1);
    filter: blur(100px);
  }
}

/* MOBILE: show smaller pig between header and buttons */
@media (max-width: 768px) {
  /* Hide desktop image on mobile */
  .hero-image-wrapper.hero-right {
    display: none;
  }

  /* Show the mobile image */
  .hero-image-wrapper-mobile {
    display: block;
    margin: 20px auto;
    max-width: 220px; /* smaller pig */
  }

  .hero-image-wrapper-mobile img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hero-content h1,
  .highlighted-text-wrapper {
    font-size: 32px;
  }

  .hero-content p {
    font-size: 18px;
  }

  .hero-buttons .btn {
    width: 100%;
    max-width: 280px;
    display: block;
    margin: 10px auto;
    text-align: center;
    z-index: 100;
  }
  .hero-image-wrapper.hero-right {
    display: none;
  }

  /* Show mobile image and glow */
  .hero-image-wrapper-mobile {
    display: block;
    margin: 20px auto;
    max-width: 220px;
  }

  .hero-image-wrapper-mobile img {
    width: 100%;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 2;
  }

  .hero-image-wrapper-mobile::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 160%;
    height: 160%;
    background: radial-gradient(circle at center, #ffdca7 0%, #ffe9c7 50%, transparent 100%);
    border-radius: 50%;
    z-index: 0;
    filter: blur(60px);
    opacity: 0.9;
    animation: glow-pulse 4s ease-in-out infinite; /* ✨ Add this line */
  }
  }
}



</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const highlight = document.getElementById("highlighted-text");

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          highlight.classList.add("active");
          observer.unobserve(highlight);
        }
      });
    }, { threshold: 0.5 });

    observer.observe(highlight);
  });
</script>


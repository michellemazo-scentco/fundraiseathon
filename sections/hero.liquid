{% schema %}
{
  "name": "Hero Landing Section",
  "tag": "section",
  "class": "hero-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "School fundraising made simple."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlighted Text",
      "default": "Share, donate, grow"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One dashboard for schools. One app for parents. Simple tracking for every dollar."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Start Fundraising"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Landing Section"
    }
  ]
}
{% endschema %}

<div class="hero-landing-container">
  <div class="hero-content hero-left">
    <h1>{{ section.settings.headline }}</h1>
    <div class="highlighted-text-wrapper">
      <span class="highlight-bg"></span>
      <span class="highlight-text">{{ section.settings.highlight_text }}</span>
    </div>
    <p>{{ section.settings.subheading }}</p>
    <div class="hero-buttons">
      <a href="{{ section.settings.primary_button_url }}" class="btn btn-primary">{{ section.settings.primary_button_text }}</a>
      <a href="{{ section.settings.secondary_button_url }}" class="btn btn-secondary">{{ section.settings.secondary_button_text }}</a>
    </div>
  </div>
  <div class="hero-image-wrapper hero-right">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="Hero Image">
    {% endif %}
  </div>
  <div class="hero-bottom-curve"></div>
</div>

<style>
.hero-landing-container {
  position: relative;
  background: #EAF3FB;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  padding: 80px 5%;
  overflow: hidden;
}

.hero-left {
  flex: 1.5;
  min-width: 300px;
  z-index: 2;
  margin-left: 100px;
}

.hero-right {
  flex: 1;
  position: relative;
  right: -100px;
  z-index: 1;
}

.hero-image-wrapper img {
  width: 100%;
  height: auto;
  max-width: 100%;
  object-fit: contain;
}

.hero-content h1 {
  font-family: 'Poppins', sans-serif;
  font-size: 42px;
  font-weight: 800px;
  color: #1F2443;
  margin-bottom: 10px;
}

.highlighted-text-wrapper {
  position: relative;
  display: inline-block;
  font-family: 'Poppins', sans-serif;
  font-size: 42px;
  font-weight: 800px;
  margin-bottom: 20px;
}

.highlight-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 50%;
  background: #fdddb9;
  z-index: 1;
  transform: translateY(5px);
}

.highlight-text {
  position: relative;
  z-index: 2;
  color: #1F2443;
}

.hero-content p {
  font-size: 24px;
  font-family: 'Roboto', sans-serif;
  color: #444;
  margin-bottom: 30px;
}

.hero-buttons .btn {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-size: 24px;
  margin-right: 15px;
}

.btn-primary {
  background-color: #E1831B;
  color: #fff;
}

.btn-secondary {
  border: 2px solid #2877C2;
  color: #2877C2;
  background: transparent;
}

.hero-bottom-curve {
  position: absolute;
  bottom: -50px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 100px;
  background: #eaf4fb;
  border-bottom-left-radius: 100% 50px;
  border-bottom-right-radius: 100% 50px;
  z-index: 0;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .hero-landing-container {
    flex-direction: column;
    text-align: center;
  }

  .hero-left, .hero-right {
    flex: 1 1 100%;
    position: static;
  }

  .hero-image-wrapper {
    margin-top: 40px;
  }

  .hero-buttons .btn {
    margin-bottom: 10px;
  }
}
</style>


{% schema %}
{
  "name": "Alternating Image + Text",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Our Features"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Block Heading",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Block Text",
          "default": "This is the feature description."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image"
        },
        {
          "type": "color",
          "id": "gradient_color",
          "label": "Gradient Overlay Color",
          "default": "#000000"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Alternating Image + Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="alternating-section">
  <div class="container">
    <h2 class="main-heading">{{ section.settings.main_heading }}</h2>

    {% for block in section.blocks %}
      {% assign index = forloop.index0 %}
      {% assign is_even = index | modulo: 2 %}

      <div class="content-block{% unless is_even %} reverse{% endunless %}">
        <div class="text-content">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>

        <div class="image-content" style="--gradient-color: {{ block.settings.gradient_color }};">
          {% if block.settings.image != blank %}
            <div class="image-wrapper">
              <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.heading }}" />
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
.alternating-section {
  padding: 60px 20px;
  background: #ffffff;
}

.alternating-section .main-heading {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 50px;
}

.alternating-section .content-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 60px;
  flex-wrap: wrap;
}

.alternating-section .content-block.reverse {
  flex-direction: row-reverse;
}

.alternating-section .text-content {
  flex: 1 1 45%;
}

.alternating-section .image-content {
  flex: 1 1 45%;
}

.image-content {
  position: relative;
  z-index: 0;
}

.image-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  z-index: 0
}

.image-wrapper img {
  position: relative;
  width: 100%;
  display: block;
  border-radius: 12px;
  z-index: 2;
}

.image-wrapper::before {
  .image-wrapper::before {
  content: "";
  position: absolute;
  top: -30%;
  left: -10%;
  width: 160%;
  height: 140%;
  background: radial-gradient(
    ellipse at 30% 40%, 
    var(--gradient-color) 0%, 
    transparent 70%
  );
  z-index: 1;
  filter: blur(60px);
  border-radius: 50%;
}
}
</style>

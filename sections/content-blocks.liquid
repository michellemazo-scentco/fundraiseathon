{% schema %}
{
  "name": "Alternating Image + Text",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Our Features"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Block Heading",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Block Text",
          "default": "This is the feature description."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image"
        },
        {
          "type": "color",
          "id": "gradient_color",
          "label": "Gradient Overlay Color",
          "default": "#000000"
        },
        {
          "type": "image_picker",
          "id": "tag_icon_1",
          "label": "Tag Icon 1"
        },
        {
          "type": "image_picker",
          "id": "tag_icon_2",
          "label": "Tag Icon 2"
        },
        {
          "type": "image_picker",
          "id": "tag_icon_3",
          "label": "Tag Icon 3"
        },
        {
          "type": "image_picker",
          "id": "tag_icon_4",
          "label": "Tag Icon 4"
        }

      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Alternating Image + Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="alternating-section">
  <div class="page-width">
    <h2 class="main-heading">{{ section.settings.main_heading }}</h2>

    {% for block in section.blocks %}
      {% assign index = forloop.index0 %}
      {% assign is_even = index | modulo: 2 %}

      <div class="content-block{% if is_even == 1 %} reverse{% endif %}">
        <div class="text-content">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
       <div class="tags-wrapper">
          {% if block.settings.tag_icon_1 != blank %}
            <div class="tag">
              <img src="{{ block.settings.tag_icon_1 | img_url: '500x500' }}" alt="Tag Icon 1" class="tag-icon" />
            </div>
          {% endif %}

          {% if block.settings.tag_icon_2 != blank %}
            <div class="tag">
              <img src="{{ block.settings.tag_icon_2 | img_url: '500x500' }}" alt="Tag Icon 2" class="tag-icon" />
            </div>
          {% endif %}

          {% if block.settings.tag_icon_3 != blank %}
            <div class="tag">
              <img src="{{ block.settings.tag_icon_3 | img_url: '500x500' }}" alt="Tag Icon 3" class="tag-icon" />
            </div>
          {% endif %}

          {% if block.settings.tag_icon_4 != blank %}
            <div class="tag">
              <img src="{{ block.settings.tag_icon_4 | img_url: '500x500' }}" alt="Tag Icon 4" class="tag-icon" />
            </div>
          {% endif %}
        </div>


        </div>

        <div class="image-content" style="--gradient-color: {{ block.settings.gradient_color }};">
          {% if block.settings.image != blank %}
            <div class="image-wrapper">
              <svg class="blob-bg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                <path fill="{{ block.settings.gradient_color }}" d="M53.6,-62.4C66.8,-50.6,72.7,-33.2,75.7,-15.6C78.8,2,79,20.1,71.3,35.6C63.7,51,48.2,63.9,31.2,69.7C14.2,75.4,-4.2,74,-21.1,67.3C-37.9,60.5,-53.2,48.5,-60.7,33.5C-68.2,18.4,-67.9,0.3,-64.3,-17.8C-60.8,-35.9,-54,-53.9,-40.7,-66.2C-27.3,-78.6,-7.6,-85.4,9.8,-83.4C27.2,-81.5,45.3,-70.1,53.6,-62.4Z" transform="translate(100 100)" />
              </svg>
              <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.heading }}" />
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="bottom-curve">
      <svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,0 C480,120 960,0 1440,120 L1440,0 L0,0 Z" fill="#FFFFFF"/>
      </svg>
  </div>
</section>

<style>
  .bottom-curve {
  width: 100%;
  line-height: 0;
  background: #2877C2;
  position: relative;
  z-index: 0; 
  overflow: visible;
}

.bottom-curve svg {
  color: #ffffff;
  display: block;
  width: 100%;
  height: auto;
  z-index: -1; 
}
.alternating-section {
  padding: 0;
  background: #ffffff;
}

.alternating-section .page-width {
  max-width: var(--page-width, 1200px); /* Shopify Dawn uses --page-width */
  margin: 0 auto;
}

.alternating-section .main-heading {
  text-align: center;
  font-family: 'Poppins', sans-serif;
  font-size: 32px;
  font-weight: 800px;
  color: #1F2443;
}

.alternating-section .content-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 60px;
  flex-wrap: nowrap;
}

.alternating-section .content-block.reverse {
  flex-direction: row-reverse;
}

.alternating-section .text-content {
  flex: 1 1 50%;
  min-width: 300px
}

.text-content h3{
  font-family: 'Poppins', sans-serif;
  font-size: 26px;
  font-weight: 800px;
  color: #1F2443;
}

.text-content p{
  font-family: 'Roboto', sans-serif;
  font-size: 18px;
  color: #1F2443;
}

.alternating-section .image-content {
  flex: 1 1 50%;
  max-width: 500px;
}

.image-content {
  position: relative;
  z-index: 0;
}

.image-wrapper {
  position: relative;
  overflow: visible;
  border-radius: 12px;
  z-index: 0
}

.blob-bg {
  position: absolute;
  top: -20%;
  left: -40%;
  width: 120%;
  height: 120%;
  z-index: 1;
  opacity: 0.4;
  filter: blur(40px);
  pointer-events: none;
}
.image-wrapper img {
  width: 100%;      /* scales fluidly within .image-content */
  height: auto;     /* keeps aspect ratio */
  display: block;
  border-radius: 12px;
  position: relative;
  z-index: 2;
}
.tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 15px;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FBCC98; /* orange background */
  border-radius: 5px;
  padding: 10px 15px;
}

.tag-icon {
  max-height: 20px;
  object-fit: contain;
  display: block;
  width: auto;
  height: auto;
}



</style>

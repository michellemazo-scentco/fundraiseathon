{% comment %}
File: sections/wheel-picker.liquid
Radial labels, full circle, top triangle picker touching rim.
{% endcomment %}

<section id="wheel-picker-{{ section.id }}" class="wheel-picker-section {% unless section.settings.show_labels_on_wheel %}wp-hide-labels{% endunless %}" style="
  --wp-bg: {{ section.settings.bg_color }};
  --wp-text: {{ section.settings.text_color }};
  --wp-accent: {{ section.settings.accent_color }};
  --wp-pointer-size: {{ section.settings.pointer_size }}px;
  --wp-pointer-offset: {{ section.settings.pointer_offset }}px;
  --wp-label-radius: {{ section.settings.label_radius | default: 42 }}px;
">
  <div class="wp-container">
    <div class="wp-grid">
      <!-- LEFT: Wheel -->
      <div class="wp-left">
        <div class="wp-wheel-wrapper">
          <!-- picker triangle (fixed) -->
          <div class="wp-pointer" aria-hidden="true"></div>

          <!-- soft shadow behind wheel -->
          <svg class="wp-shadow-plate" viewBox="-125 -125 250 250" aria-hidden="true">
            <defs>
              <radialGradient id="wp-shadow-grad-{{ section.id }}" cx="50%" cy="40%" r="70%">
                <stop offset="0%" stop-color="rgba(0,0,0,0.06)"/>
                <stop offset="100%" stop-color="rgba(0,0,0,0.0)"/>
              </radialGradient>
            </defs>
            <circle r="118" fill="url(#wp-shadow-grad-{{ section.id }})"></circle>
          </svg>

          <!-- main wheel (rotates) -->
          <svg class="wp-wheel" viewBox="-120 -120 240 240" role="img" aria-label="Selection wheel">
            <!-- slices/labels injected by JS -->
            <circle class="wp-rim" r="112"></circle>
            <circle class="wp-rim-glow" r="115"></circle>
          </svg>

          <!-- center cap -->
          <div class="wp-cap-wrap">
            <svg class="wp-cap" viewBox="-40 -40 80 80" aria-hidden="true">
              <defs>
                <radialGradient id="wp-cap-grad-{{ section.id }}" cx="50%" cy="45%" r="60%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="100%" stop-color="#f4f7fb"/>
                </radialGradient>
              </defs>
              <circle r="26" fill="url(#wp-cap-grad-{{ section.id }})" />
              <circle r="26" fill="none" stroke="rgba(0,0,0,.06)" stroke-width="1" />
            </svg>
          </div>
        </div>
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" id="wp-live-{{ section.id }}"></p>
      </div>

      <!-- RIGHT: Content -->
      <div class="wp-right">
        <header class="wp-header">
          <h2 class="wp-heading" data-base-heading="{{ section.settings.heading | escape }}">
            {{ section.settings.heading | escape }}
          </h2>
          {% if section.settings.subheading != blank %}
            <p class="wp-subheading">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </header>

        <div class="wp-panel wp-panel-initial">
          <button type="button" class="wp-btn wp-btn-primary" data-role="spin">{{ section.settings.spin_label | escape }}</button>
        </div>

        <div class="wp-panel wp-panel-result" hidden>
          <h3 class="wp-result-heading"></h3>
          <div class="wp-result-card">
            <img class="wp-result-img" src="" alt="" loading="lazy">
          </div>
          <button type="button" class="wp-btn wp-btn-secondary" data-role="respin">{{ section.settings.respin_label | escape }}</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('wheel-picker-{{ section.id }}');
      if (!root) return;

      const options = [
        {% for block in section.blocks %}
          {
            id: "{{ block.id }}",
            label: {{ block.settings.label | json }},
            image: {{ block.settings.image | img_url: '800x' | json }},
            imageAlt: {{ block.settings.label | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ].filter(o => o.label && o.label.trim().length > 0);

      const n = Math.min(options.length, 5);
      const spinMs = Math.max(300, parseInt({{ section.settings.spin_duration_ms | json }}) || 2200);
      const template = {{ section.settings.result_heading_template | json }};

      const svg = root.querySelector('.wp-wheel');
      const headingEl = root.querySelector('.wp-heading');
      const baseHeading = headingEl.dataset.baseHeading || headingEl.textContent.trim();
      const live = root.querySelector('#wp-live-{{ section.id }}');

      const panelInitial = root.querySelector('.wp-panel-initial');
      const panelResult  = root.querySelector('.wp-panel-result');
      const resultHeading = root.querySelector('.wp-result-heading');
      const resultImg = root.querySelector('.wp-result-img');
      const btnSpin = root.querySelector('[data-role="spin"]');
      const btnRespin = root.querySelector('[data-role="respin"]');
      const labelRadiusPx = parseFloat(getComputedStyle(root).getPropertyValue('--wp-label-radius')) || 42;
      const POINTER_DEG = 90; // pointer at right (0 = top)


      if (n < 2) { btnSpin.disabled = true; btnSpin.textContent = 'Add at least 2 options'; }

      const blues = ['#E3F2FD','#BBDEFB','#90CAF9','#64B5F6','#42A5F5','#1E88E5'];

      const radius = 108;              // safe within viewBox
      const innerLabelRadius = 34;     // why: start near center and point outward
      const sliceAngle = 360 / (n || 1);

      const NS = 'http://www.w3.org/2000/svg';
      const mk = (tag) => document.createElementNS(NS, tag);

      function polar(r, deg) {
        const rad = (deg - 90) * Math.PI / 180;
        return { x: r * Math.cos(rad), y: r * Math.sin(rad) };
      }
      function slicePath(startDeg, endDeg, r) {
        const start = polar(r, endDeg);
        const end = polar(r, startDeg);
        const largeArc = endDeg - startDeg <= 180 ? 0 : 1;
        return `M 0 0 L ${start.x} ${start.y} A ${r} ${r} 0 ${largeArc} 0 ${end.x} ${end.y} Z`;
      }

      function buildWheel() {
        [...svg.querySelectorAll('.wp-slice, .wp-label')].forEach(n => n.remove());

        for (let i = 0; i < n; i++) {
          const start = i * sliceAngle;
          const end = (i + 1) * sliceAngle;

          const path = mk('path');
          path.setAttribute('d', slicePath(start, end, radius));
          path.setAttribute('class', 'wp-slice');
          path.setAttribute('fill', blues[i % blues.length]);
          path.setAttribute('stroke', '#ffffff');
          path.setAttribute('stroke-width', '1');
          svg.insertBefore(path, svg.firstChild);

          // Radial label: start near center, extend outward along the slice mid-angle
          const mid = start + sliceAngle / 2;
            const text = mk('text');
            text.setAttribute('class', 'wp-label');
            text.setAttribute('text-anchor', 'middle');       // center on the ray
            text.setAttribute('dominant-baseline', 'middle');
            text.setAttribute('transform', `rotate(${mid})`);
            text.setAttribute('x', String(labelRadiusPx));    // e.g., 42px from center
            text.setAttribute('y', '0');
            text.textContent = options[i].label;
            svg.appendChild(text);


        }
      }
      buildWheel();

      // Spin logic
      let spinning = false;
      let currentRotation = 0;
      const fullTurns = 6;

     function indexFromRotation(rotDeg) {
        const norm = ((rotDeg % 360) + 360) % 360;
        const hitDeg = (POINTER_DEG - norm + 360) % 360;
        return Math.floor(hitDeg / sliceAngle) % n;
    }

      function setPanels(showResult) {
        panelInitial.hidden = !!showResult;
        panelResult.hidden  = !showResult;
      }

      function spinOnce() {
        if (spinning || n < 2) return;
        spinning = true;

        headingEl.textContent = baseHeading;
        setPanels(false);
        btnSpin.setAttribute('aria-busy', 'true');
        btnSpin.disabled = true;

        const targetIndex = Math.floor(Math.random() * n);
        const targetCenterDeg = (targetIndex * sliceAngle) + sliceAngle / 2;
        const jitter = Math.random() * 8 - 4;
        const delta = fullTurns * 360 + (targetCenterDeg - POINTER_DEG) + jitter;
        const nextRotation = currentRotation + delta;

        svg.style.transition = `transform ${spinMs}ms cubic-bezier(0.12, 0.65, 0, 1)`;
        svg.style.transform = `rotate(${nextRotation}deg)`;

        const onEnd = () => {
          svg.removeEventListener('transitionend', onEnd);
          currentRotation = nextRotation % 360;
          svg.style.transition = 'none';
          svg.style.transform = `rotate(${currentRotation}deg)`;

          const idx = indexFromRotation(currentRotation);
          const chosen = options[idx];
          const newHeading = (template && template.includes('{word}'))
            ? template.replace('{word}', chosen.label)
            : `You should choose ${chosen.label}`;

          headingEl.textContent = newHeading;
          resultHeading.textContent = newHeading;

          if (chosen.image) {
            resultImg.src = chosen.image;
            resultImg.alt = chosen.imageAlt || chosen.label;
          } else {
            resultImg.removeAttribute('src');
            resultImg.alt = '';
          }

          setPanels(true);
          if (live) live.textContent = `Selected ${chosen.label}`;

          btnSpin.disabled = false;
          btnSpin.removeAttribute('aria-busy');
          spinning = false;
        };

        const timeoutId = setTimeout(() => { if (spinning) onEnd(); }, spinMs + 100);
        svg.addEventListener('transitionend', () => { clearTimeout(timeoutId); onEnd(); }, { once: true });
      }

      btnSpin?.addEventListener('click', spinOnce);
      btnRespin?.addEventListener('click', () => { setPanels(false); spinOnce(); });

      const media = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (media.matches) svg.style.transitionDuration = '300ms';
    })();
  </script>

  <style>
    .wheel-picker-section { background: var(--wp-bg); color: var(--wp-text); padding: 2rem 1rem; }
    .wp-container { max-width: 1100px; margin: 0 auto; }
    .wp-grid { display: grid; gap: 1.5rem; align-items: center; }
    @media (min-width: 900px) { .wp-grid { grid-template-columns: 1fr 1fr; } }

    /* LEFT */
    .wp-left { display: grid; place-items: center; }
    .wp-wheel-wrapper { position: relative; width: min(88vw, 440px); aspect-ratio: 1 / 1; }
    .wp-shadow-plate, .wp-wheel { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

   
    /* Right-side triangle picker – tip touches the rim */
    .wp-pointer{
        position: absolute;
        top: 50%;
        left: calc(100% - var(--wp-pointer-offset)); /* nudge inward/outward */
        transform: translateY(-50%);
        width: 0; height: 0;
        border-top:  calc(var(--wp-pointer-size) * .6) solid transparent;
        border-bottom: calc(var(--wp-pointer-size) * .6) solid transparent;
        border-right: var(--wp-pointer-size) solid var(--wp-accent); /* points right */
        filter: drop-shadow(0 2px 2px rgba(0,0,0,.25));
        z-index: 2;
    }



    /* Rim */
    .wp-rim { fill: none; stroke: #E6F0FF; stroke-width: 8; }
    .wp-rim-glow { fill: none; stroke: rgba(30,136,229,.18); stroke-width: 8; }

    /* Slices & labels */
    .wp-slice { transition: filter .2s ease; }
    .wp-wheel:hover .wp-slice { filter: brightness(1.02); }

    .wp-label{
      font-size: 12px;
      font-weight: 700;
      fill: #0a2540;
      paint-order: stroke;    /* why: keep outline under text for contrast */
      stroke: #ffffff;
      stroke-width: 2px;
      letter-spacing: .2px;
      user-select: none;
      pointer-events: none;
    }
    .wp-hide-labels .wp-label { display: none; }

    /* Center cap */
    .wp-cap-wrap { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
    .wp-cap { width: 36%; height: 36%; filter: drop-shadow(0 6px 20px rgba(0,0,0,.12)); }

    /* RIGHT */
    .wp-right { max-width: 560px; margin: 0 auto; }
    .wp-header { margin-bottom: .75rem; }
    .wp-heading { font-size: clamp(1.5rem, 2.5vw, 2.25rem); margin: 0; }
    .wp-subheading { margin: .25rem 0 0; opacity: .85; }
    .wp-panel { margin-top: 1rem; }
    .wp-btn {
      border: 0; padding: .8rem 1.4rem; border-radius: 999px; font-weight: 600;
      transition: transform .12s ease, opacity .2s ease; cursor: pointer;
    }
    .wp-btn[disabled] { opacity: .6; cursor: not-allowed; }
    .wp-btn:active { transform: scale(.98); }
    .wp-btn-primary { background: var(--wp-accent); color: #fff; }
    .wp-btn-secondary { background: transparent; color: var(--wp-accent); outline: 2px solid var(--wp-accent); }

    .wp-result-card { margin: .75rem 0 1rem; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
    .wp-result-img { width: 100%; height: auto; display: block; }

    .visually-hidden {
      position: absolute!important; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); border: 0; white-space: nowrap;
    }
  </style>

  {% schema %}
  {
    "name": "Wheel Picker",
    "tag": "section",
    "class": "shopify-section--wheel-picker",
    "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "What should you choose?" },
      { "type": "text", "id": "subheading", "label": "Subheading", "default": "Spin the wheel to decide." },
      { "type": "text", "id": "spin_label", "label": "Spin button label", "default": "Spin" },
      { "type": "text", "id": "respin_label", "label": "Respin button label", "default": "Respin" },
      { "type": "text", "id": "result_heading_template", "label": "Result heading template (use {word})", "default": "You should choose {word}" },
      { "type": "range", "id": "spin_duration_ms", "label": "Spin duration (ms)", "min": 300, "max": 5000, "step": 100, "default": 2200, "unit": "ms" },
      { "type": "checkbox", "id": "show_labels_on_wheel", "label": "Show labels on wheel", "default": true },
      { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
      { "type": "color", "id": "text_color", "label": "Text color", "default": "#1f2937" },
      { "type": "color", "id": "accent_color", "label": "Accent color (buttons/pointer)", "default": "#1E88E5" },
      { "type": "range", "id": "label_radius", "label": "Label radius (from center)", "min": 24, "max": 70, "step": 1, "default": 42 },
      { "type": "range", "id": "pointer_size", "label": "Pointer size", "min": 16, "max": 48, "step": 1, "default": 28 },
      { "type": "range", "id": "pointer_offset", "label": "Pointer tip offset", "min": -20, "max": 20, "step": 1, "default": 4 }

    ],
    "blocks": [
      {
        "type": "option",
        "name": "Option",
        "limit": 5,
        "settings": [
          { "type": "text", "id": "label", "label": "Word label", "default": "Option" },
          { "type": "image_picker", "id": "image", "label": "Associated image" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Wheel Picker (Blue)",
        "category": "Interactive",
        "blocks": [
          { "type": "option", "settings": { "label": "Option 1" } },
          { "type": "option", "settings": { "label": "Option 2" } },
          { "type": "option", "settings": { "label": "Option 3" } },
          { "type": "option", "settings": { "label": "Option 4" } },
          { "type": "option", "settings": { "label": "Option 5" } }
        ]
      }
    ]
  }
  {% endschema %}
</section>




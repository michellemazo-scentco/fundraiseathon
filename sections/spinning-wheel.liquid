{% comment %}
File: sections/wheel-picker.liquid
Purpose: Animated wheel that picks 1 of up to 5 words; shows associated image; editable in Theme Editor.
{% endcomment %}

<section id="wheel-picker-{{ section.id }}" class="wheel-picker-section" style="
  --wp-bg: {{ section.settings.bg_color }};
  --wp-text: {{ section.settings.text_color }};
  --wp-accent: {{ section.settings.accent_color }};
">
  <div class="wp-container">
    <header class="wp-header">
      <h2 class="wp-heading" data-base-heading="{{ section.settings.heading | escape }}">
        {{ section.settings.heading | escape }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="wp-subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="wp-wheel-area">
      <div class="wp-wheel-wrapper">
        <div class="wp-pointer" aria-hidden="true"></div>
        <svg class="wp-wheel" viewBox="-110 -110 220 220" role="img" aria-label="Selection wheel">
          <!-- Slices and labels injected by JS -->
        </svg>
      </div>
      <div class="wp-result">
        <div class="wp-result-image" hidden>
          <img src="" alt="" loading="lazy">
        </div>
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" id="wp-live-{{ section.id }}"></p>
      </div>
    </div>

    <div class="wp-actions">
      <button type="button" class="wp-btn" data-state="idle">{{ section.settings.spin_label | escape }}</button>
    </div>
  </div>

  <script>
    (() => {
      // Why: Keep per-section isolation and avoid global collisions.
      const root = document.getElementById('wheel-picker-{{ section.id }}');
      if (!root) return;

      // Data from Liquid (blocks -> options)
      const options = [
        {% for block in section.blocks %}
          {
            id: "{{ block.id }}",
            label: {{ block.settings.label | json }},
            image: {{ block.settings.image | img_url: '800x' | json }},
            imageAlt: {{ block.settings.label | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ].filter(o => o.label && o.label.trim().length > 0);

      const maxN = 5;
      const n = Math.min(options.length, maxN);
      const spinMs = Math.max(300, parseInt({{ section.settings.spin_duration_ms | json }}) || 2200);
      const template = {{ section.settings.result_heading_template | json }}; // must contain {word}

      const svg = root.querySelector('.wp-wheel');
      const btn = root.querySelector('.wp-btn');
      const headingEl = root.querySelector('.wp-heading');
      const baseHeading = headingEl.dataset.baseHeading || headingEl.textContent.trim();
      const pointerLive = root.querySelector('#wp-live-{{ section.id }}');
      const resultImageWrap = root.querySelector('.wp-result-image');
      const resultImg = resultImageWrap.querySelector('img');

      if (n < 2) {
        btn.disabled = true;
        btn.textContent = 'Add at least 2 options';
      }

      const radius = 100;
      const sliceAngle = 360 / (n || 1);

      // Build wheel slices + labels
      function polarToCartesian(cx, cy, r, deg) {
        const rad = (deg - 90) * Math.PI / 180;
        return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
      }

      function describeSlice(startDeg, endDeg, r) {
        const start = polarToCartesian(0,0,r, endDeg);
        const end = polarToCartesian(0,0,r, startDeg);
        const largeArc = endDeg - startDeg <= 180 ? 0 : 1;
        return `M 0 0 L ${start.x} ${start.y} A ${r} ${r} 0 ${largeArc} 0 ${end.x} ${end.y} Z`;
      }

      function buildWheel() {
        svg.innerHTML = '';
        for (let i = 0; i < n; i++) {
          const start = i * sliceAngle;
          const end = (i + 1) * sliceAngle;
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', describeSlice(start, end, radius));
          path.setAttribute('class', 'wp-slice');
          path.setAttribute('data-index', String(i));
          svg.appendChild(path);

          // Label at slice center
          const mid = start + sliceAngle / 2;
          const labelR = radius * 0.6;
          const pos = polarToCartesian(0,0,labelR, mid);
          const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          text.setAttribute('x', String(pos.x));
          text.setAttribute('y', String(pos.y));
          text.setAttribute('class', 'wp-label');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('dominant-baseline', 'middle');
          text.textContent = options[i].label;
          svg.appendChild(text);
        }
      }

      buildWheel();

      // Spin state
      let spinning = false;
      let currentRotation = 0; // deg
      const fullTurns = 6; // why: adds drama; deterministic offset handled below

      function indexFromRotation(rotDeg) {
        // Normalize so 0 deg means pointer at top selecting slice centered at 0 deg
        const norm = ((rotDeg % 360) + 360) % 360;
        const pointerDeg = 0; // pointer at 0 degrees (top)
        const hitDeg = (pointerDeg - norm + 360) % 360;
        const idx = Math.floor(hitDeg / sliceAngle) % n;
        return idx;
      }

      function spinOnce() {
        if (spinning || n < 2) return;
        spinning = true;
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;

        // Pick target index uniformly
        const targetIndex = Math.floor(Math.random() * n);

        // Compute rotation so that targetIndex centers at pointer (0 deg).
        const targetCenterDeg = (targetIndex * sliceAngle) + sliceAngle / 2;
        // We want wheel to rotate so that targetCenterDeg ends up at 0: rotation delta = targetCenterDeg
        // Add fullTurns for nice spin; subtract small random jitter to feel organic.
        const jitter = Math.random() * 8 - 4;
        const delta = fullTurns * 360 + targetCenterDeg + jitter;

        const nextRotation = currentRotation + delta;

        // Apply transition
        svg.style.transition = `transform ${spinMs}ms cubic-bezier(0.12, 0.65, 0, 1)`;
        svg.style.transform = `rotate(${nextRotation}deg)`;

        const onEnd = () => {
          svg.removeEventListener('transitionend', onEnd);
          // Freeze rotation to an exact angle to avoid drift, then drop transition
          currentRotation = nextRotation % 360;
          svg.style.transition = 'none';
          svg.style.transform = `rotate(${currentRotation}deg)`;

          const idx = indexFromRotation(currentRotation);
          const chosen = options[idx];

          // Update heading
          const newHeading = (template && template.includes('{word}'))
            ? template.replace('{word}', chosen.label)
            : `You should choose ${chosen.label}`;
          headingEl.textContent = newHeading;

          // Update image (hide if absent)
          if (chosen.image) {
            resultImg.src = chosen.image;
            resultImg.alt = chosen.imageAlt || chosen.label;
            resultImageWrap.hidden = false;
          } else {
            resultImg.removeAttribute('src');
            resultImageWrap.hidden = true;
          }

          // A11y live announcement
          if (pointerLive) {
            pointerLive.textContent = `Selected ${chosen.label}`;
          }

          // Toggle button to "Respin"
          btn.dataset.state = 'done';
          btn.textContent = {{ section.settings.respin_label | json }};
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          spinning = false;
        };

        // Reset heading immediately so change after spin is perceptible
        headingEl.textContent = baseHeading;
        resultImageWrap.hidden = true;

        // Ensure handler runs even if 'transitionend' misses (e.g., reduced motion)
        const timeoutId = setTimeout(() => {
          if (spinning) onEnd();
        }, spinMs + 60);

        svg.addEventListener('transitionend', () => {
          clearTimeout(timeoutId);
          onEnd();
        }, { once: true });
      }

      btn?.addEventListener('click', () => {
        if (btn.dataset.state === 'done') {
          // Reset UI for next spin
          headingEl.textContent = baseHeading;
          resultImageWrap.hidden = true;
          btn.textContent = {{ section.settings.spin_label | json }};
          btn.dataset.state = 'idle';
        }
        spinOnce();
      });

      // Respect prefers-reduced-motion
      const media = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (media.matches) {
        // Shorten spin to be considerate
        svg.style.transitionDuration = '300ms';
      }
    })();
  </script>

  <style>
    .wheel-picker-section {
      background: var(--wp-bg);
      color: var(--wp-text);
      padding: 2rem 1rem;
    }
    .wp-container {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
    }
    .wp-header { margin-bottom: 1rem; }
    .wp-heading { font-size: clamp(1.5rem, 2.5vw, 2.25rem); margin: 0; }
    .wp-subheading { margin: .5rem 0 0; opacity: .85; }
    .wp-wheel-area {
      display: grid;
      gap: 1rem;
      align-items: center;
      justify-items: center;
      margin-top: 1rem;
    }
    .wp-wheel-wrapper {
      position: relative;
      width: min(80vw, 360px);
      aspect-ratio: 1/1;
      display: grid;
      place-items: center;
    }
    .wp-wheel {
      width: 100%;
      height: 100%;
      transform: rotate(0deg);
      will-change: transform; /* why: smooth animation on most devices */
    }
    .wp-pointer {
      position: absolute;
      top: -8px;
      width: 0; height: 0;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;
      border-bottom: 16px solid var(--wp-accent);
      filter: drop-shadow(0 2px 2px rgba(0,0,0,.2));
    }
    .wp-slice {
      fill: none;
      stroke: var(--wp-accent);
      stroke-width: 1;
    }
    /* Alternate light/dark fills without hardcoding colors; uses opacity with accent */
    .wp-slice:nth-of-type(odd) { fill: color-mix(in oklab, var(--wp-accent) 14%, white); }
    .wp-slice:nth-of-type(even){ fill: color-mix(in oklab, var(--wp-accent) 6%, white); }
    .wp-label {
      font-size: 12px;
      pointer-events: none;
      fill: currentColor;
    }
    .wp-actions { margin-top: 1rem; }
    .wp-btn {
      background: var(--wp-accent);
      color: #fff;
      border: 0;
      padding: .75rem 1.25rem;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      transition: transform .12s ease, opacity .2s ease;
    }
    .wp-btn[disabled] { opacity: .6; cursor: not-allowed; }
    .wp-btn:active { transform: scale(.98); }
    .wp-result-image {
      margin-top: .5rem;
      max-width: min(80vw, 360px);
    }
    .wp-result-image img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0,0,0,.15);
    }
    .visually-hidden {
      position: absolute!important; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
      border: 0; white-space: nowrap;
    }
  </style>

  {% schema %}
  {
    "name": "Wheel Picker",
    "tag": "section",
    "class": "shopify-section--wheel-picker",
    "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "What should you choose?" },
      { "type": "text", "id": "subheading", "label": "Subheading", "default": "Spin the wheel to decide." },
      { "type": "text", "id": "spin_label", "label": "Spin button label", "default": "Spin" },
      { "type": "text", "id": "respin_label", "label": "Respin button label", "default": "Respin" },
      { "type": "text", "id": "result_heading_template", "label": "Result heading template (use {word})", "default": "You should choose {word}" },
      { "type": "range", "id": "spin_duration_ms", "label": "Spin duration (ms)", "default": 2200, "min": 300, "max": 5000, "step": 100 },
      { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
      { "type": "color", "id": "text_color", "label": "Text color", "default": "#1f2937" },
      { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111827" }
    ],
    "blocks": [
      {
        "type": "option",
        "name": "Option",
        "limit": 5,
        "settings": [
          { "type": "text", "id": "label", "label": "Word label", "default": "Option" },
          { "type": "image_picker", "id": "image", "label": "Associated image" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Wheel Picker",
        "category": "Interactive",
        "blocks": [
          { "type": "option", "settings": { "label": "Vanilla" } },
          { "type": "option", "settings": { "label": "Chocolate" } },
          { "type": "option", "settings": { "label": "Strawberry" } },
          { "type": "option", "settings": { "label": "Matcha" } },
          { "type": "option", "settings": { "label": "Mango" } }
        ]
      }
    ]
  }
  {% endschema %}
</section>



{% schema %}
{
  "name": "Spinning Wheel",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Spin the Wheel!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Try your luck and see what you get!"
    },
    {
      "type": "header",
      "content": "Options (Labels & Images)"
    },
    {
      "type": "text",
      "id": "option_1_label",
      "label": "Option 1 Label",
      "default": "Option 1"
    },
    {
      "type": "image_picker",
      "id": "option_1_image",
      "label": "Option 1 Image"
    },
    {
      "type": "text",
      "id": "option_2_label",
      "label": "Option 2 Label",
      "default": "Option 2"
    },
    {
      "type": "image_picker",
      "id": "option_2_image",
      "label": "Option 2 Image"
    },
    {
      "type": "text",
      "id": "option_3_label",
      "label": "Option 3 Label",
      "default": "Option 3"
    },
    {
      "type": "image_picker",
      "id": "option_3_image",
      "label": "Option 3 Image"
    },
    {
      "type": "text",
      "id": "option_4_label",
      "label": "Option 4 Label",
      "default": "Option 4"
    },
    {
      "type": "image_picker",
      "id": "option_4_image",
      "label": "Option 4 Image"
    },
    {
      "type": "text",
      "id": "option_5_label",
      "label": "Option 5 Label",
      "default": "Option 5"
    },
    {
      "type": "image_picker",
      "id": "option_5_image",
      "label": "Option 5 Image"
    }
  ],
  "presets": [
    {
      "name": "Spinning Wheel"
    }
  ]
}
{% endschema %}

<div class="spinning-wheel-container">
  <div class="canvas-wrapper">
    <canvas id="wheel-canvas" width="400" height="400"></canvas>
    <div class="wheel-pointer"></div>
  </div>
  <div class="wheel-info">
    <h2 id="wheel-header">{{ section.settings.main_heading }}</h2>
    <p id="wheel-subheader">{{ section.settings.subheading }}</p>
    <button id="spin-btn">Spin</button>
    <div id="result-image" class="hidden"></div>
  </div>
</div>

<style>
.spinning-wheel-container {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}
.canvas-wrapper {
  position: relative;
  width: 400px;
  height: 400px;
}
#wheel-canvas {
  display: block;
  border-radius: 50%;
}
.wheel-pointer {
  position: absolute;
  top: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20px solid transparent;
  border-right: 20px solid transparent;
  border-bottom: 30px solid #333;
  z-index: 10;
}
.wheel-info {
  max-width: 400px;
  text-align: center;
}
#result-image {
  margin-top: 1rem;
  width: 200px;
  height: 200px;
  background-size: cover;
  background-position: center;
}
.hidden {
  display: none;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const canvas = document.getElementById("wheel-canvas");
  const ctx = canvas.getContext("2d");
  const spinBtn = document.getElementById("spin-btn");
  const resultImage = document.getElementById("result-image");
  const header = document.getElementById("wheel-header");

  const labels = [
    {{ section.settings.option_1_label | json }},
    {{ section.settings.option_2_label | json }},
    {{ section.settings.option_3_label | json }},
    {{ section.settings.option_4_label | json }},
    {{ section.settings.option_5_label | json }}
  ];

  const images = [
    {{ section.settings.option_1_image | image_url: width: 600 | json }},
    {{ section.settings.option_2_image | image_url: width: 600 | json }},
    {{ section.settings.option_3_image | image_url: width: 600 | json }},
    {{ section.settings.option_4_image | image_url: width: 600 | json }},
    {{ section.settings.option_5_image | image_url: width: 600 | json }}
  ];

  const colors = ["#cce7ff", "#a3d4f7", "#7ac2f0", "#52b0e8", "#299ee1"];
  const sliceCount = labels.length;
  const sliceAngle = 2 * Math.PI / sliceCount;

  let rotation = 0;
  let spinning = false;

  function drawWheel(rotationAngle = 0) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.translate(200, 200);
    ctx.rotate(rotationAngle);
    for (let i = 0; i < sliceCount; i++) {
      const angle = i * sliceAngle;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, 200, angle, angle + sliceAngle);
      ctx.fillStyle = colors[i % colors.length];
      ctx.fill();
      ctx.stroke();

      // Add text
      ctx.save();
      ctx.rotate(angle + sliceAngle / 2);
      ctx.translate(130, 0);
      ctx.rotate(Math.PI / 2);
      ctx.fillStyle = "#fff";
      ctx.font = "bold 14px Arial";
      ctx.textAlign = "center";
      ctx.fillText(labels[i], 0, 0);
      ctx.restore();
    }
    ctx.restore();
  }

  function spinWheel() {
    if (spinning) return;
    spinning = true;

    const randomExtra = Math.random() * 360;
    const spins = 6; // full spins
    const targetAngle = (spins * 360 + randomExtra);
    const duration = 4000;
    const start = performance.now();

    function animate(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const currentRotation = (rotation + eased * targetAngle) % 360;
      const radians = currentRotation * Math.PI / 180;
      drawWheel(radians);

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        rotation = (rotation + targetAngle) % 360;
        const selectedIndex = Math.floor(sliceCount - ((rotation % 360) / 360 * sliceCount)) % sliceCount;
        header.textContent = `You got: ${labels[selectedIndex]}`;
        resultImage.style.backgroundImage = `url(${images[selectedIndex]})`;
        resultImage.classList.remove("hidden");
        spinBtn.textContent = "Respin";
        spinning = false;
      }
    }

    requestAnimationFrame(animate);
  }

  drawWheel(); // Draw initial wheel
  spinBtn.addEventListener("click", spinWheel);
});
</script>



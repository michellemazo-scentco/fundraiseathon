{% schema %}
{
  "name": "Rich Text with Image",
  "tag": "section",
  "class": "rich-text-with-image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>This is some rich body text.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Rich Text with Image"
    }
  ]
}
{% endschema %}

<section class="rich-text-with-image-section">
  <div class="page-width text-center">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.body_text != blank %}
      <div class="rte">{{ section.settings.body_text }}</div>
    {% endif %}

    {% if section.settings.image %}
      <div class="image-wrapper">
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      </div>
    {% endif %}
  </div>
  <div class="hero-bottom-curve">
    <svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,0 C480,120 960,0 1440,120 L1440,0 L0,0 Z" fill="#2877C2"/>
    </svg>
  </div>
</section>

<style>
  .rich-text-with-image-section {
    padding: 40px 0;
    background: #2877C2;
    font-size: 20px;
  }

  .rich-text-with-image-section h2 {
    margin-bottom: 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 42px;
    font-weight: 800px;
    color: #ffffff;
  }

  .rich-text-with-image-section p {
    font-size: 20px;
    font-family: 'Roboto', sans-serif;
    color: #ffffff;
    align-items: left;
    padding: 0;
    margin: 0;
  }

  .rich-text-with-image-section .rte {
    margin-bottom: 30px;
    
    
  }

  .rich-text-with-image-section .image-wrapper img {
    max-width: 100%;
    height: auto;
  }
</style>
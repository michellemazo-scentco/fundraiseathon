{% schema %}
{
  "name": "Reviews Carousel",
  "settings": [
    {
      "type": "text",
      "id": "review_heading",
      "label": "Review Heading",
      "default": "Our Features"
    },
    {
      "type": "textarea",
      "id": "review_body",
      "label": "Review Section Body",
      "default": "Default"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Body"
        },
        {
          "type": "text",
          "id": "reviewer",
          "label": "Reviewer Name"
        },
        {
          "type": "text",
          "id": "school",
          "label": "School Name"
        },
        {
          "type": "image_picker",
          "id": "school_logo",
          "label": "School Logo"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Reviews Carousel",
      "category": "Testimonials"
    }
  ]
}
{% endschema %}

{% stylesheet %}
/* --- General Section Styles --- */
.review-heading {
  font-family: 'Poppins', sans-serif;
  font-size: 29px;
  font-weight: 800;
  color: #1F2443;
  margin-bottom: 10px;
  text-align: center;
}

.review-subheading {
  font-family: 'Roboto', sans-serif;
  font-size: 20px;
  color: #1F2443;
  margin: 0 0 50px;
  text-align: center;
}

/* --- Carousel Container --- */
.review-carousel-container {
  position: relative;
  overflow: hidden;
  max-width: 1200px;
  margin: 50px auto;
  background: #EAF3FB;
  padding: 30px 15px;
  border-radius: 12px;
}

.review-track {
  display: flex;
  transition: transform 0.4s ease;
  will-change: transform;
  align-items: stretch;
}

/* --- Review Card --- */
.review-card {
  display: flex;
  flex: 0 0 33.3333%;
  flex-direction: column;
  justify-content: space-between;
  padding: 1rem;
  margin-right: 20px;
  border: 1px solid #2877C2;
  border-radius: 15px;
  text-align: left;
  color: #1F2443;
  height: 400px;
  max-width: 350px;
  background: #fff;
  transition: all 0.3s ease;
}

.review-card.active {
  background-color: #2877C2;
  border-color: #2877C2;
  color: #fff;
}

/* --- Stars --- */
.stars {
  color: #2877C2;
  margin: 10px 0 20px;
}

.review-card.active .stars-icon {
  color: #fff;
}

/* --- Content --- */
.review-title {
  font-family: 'Roboto', sans-serif;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 10px;
}

.review-body {
  font-family: 'Roboto', sans-serif;
  font-size: 18px;
  margin-bottom: 20px;
}

/* --- Footer --- */
.review-footer {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.school-logo {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.review-meta {
  text-align: left;
}

.review-meta .name {
  font-weight: bold;
}

.review-meta .school {
  font-style: italic;
  font-size: 0.85rem;
}

/* --- Navigation --- */
.carousel-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-top: 1.5rem;
}

.carousel-dots {
  display: flex;
  align-items: center;
  gap: 8px;
}

.carousel-dots span {
  width: 10px;
  height: 10px;
  background: #ccc;
  border-radius: 50%;
  cursor: pointer;
  transition: background 0.3s ease;
}

.carousel-dots span.active {
  background: #007aff;
}

.arrow-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-btn svg {
  width: 20px;
  height: 20px;
  color: #2877C2;
  transition: color 0.3s ease;
}

.arrow-btn:hover svg {
  color: #1F2443;
}

/* --- Responsive --- */
@media screen and (max-width: 768px) {
  .review-card {
    flex: 0 0 100%;
    margin: 0 auto;
    max-width: 100%;
  }

  .review-carousel-container {
    padding: 20px;
  }

  .carousel-navigation {
    margin-top: 1rem;
  }
}
{% endstylesheet %}

<div class="review-carousel-container" data-reviews-carousel>
  <h2 class="review-heading">{{ section.settings.review_heading }}</h2>
  <p class="review-subheading">{{ section.settings.review_body }}</p>

  <div class="review-track">
    {% for block in section.blocks %}
      <div class="review-card{% if forloop.index == 2 %} active{% endif %}">
        <div class="card-content">
          <div class="stars">
            <svg class="stars-icon" width="135" height="21" viewBox="0 0 208 33" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="..." fill="currentColor"/>
            </svg>
          </div>
          <div class="review-title">{{ block.settings.title }}</div>
          <div class="review-body">{{ block.settings.body }}</div>
        </div>
        <div class="review-footer">
          {% if block.settings.school_logo %}
            <img src="{{ block.settings.school_logo | img_url: '60x60' }}" class="school-logo" alt="{{ block.settings.school }}">
          {% endif %}
          <div class="review-meta">
            <div class="name">{{ block.settings.reviewer }}</div>
            <div class="school">{{ block.settings.school }}</div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="carousel-navigation">
    <button class="arrow-btn" data-carousel-prev aria-label="Previous review">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512">
        <path d="M7.7 235.8c-10.3 12.6-9.5 31.1 2.2 42.8l128 128c9.2 9.2 22.9 11.9 34.9 6.9s19.8-16.6 19.8-29.6l0-256c0-12.9-7.8-24.6-19.8-29.6s-25.7-2.2-34.9 6.9l-128 128-2.2 2.4z" fill="currentColor"/>
      </svg>
    </button>

    <div class="carousel-dots">
      {% for block in section.blocks %}
        <span class="{% if forloop.index == 2 %}active{% endif %}" data-dot-index="{{ forloop.index0 }}"></span>
      {% endfor %}
    </div>

    <button class="arrow-btn" data-carousel-next aria-label="Next review">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512">
        <path d="M249.3 235.8c10.2 12.6 9.5 31.1-2.2 42.8l-128 128c-9.2 9.2-22.9 11.9-34.9 6.9S64.5 396.9 64.5 384l0-256c0-12.9 7.8-24.6 19.8-29.6s25.7-2.2 34.9 6.9l128 128 2.2 2.4z" fill="currentColor"/>
      </svg>
    </button>
  </div>
</div>

{% javascript %}
<script>
(() => {
  const container = document.querySelector('[data-reviews-carousel]');
  if (!container) return;

  const track = container.querySelector('.review-track');
  const cards = container.querySelectorAll('.review-card');
  const dots = container.querySelectorAll('.carousel-dots span');
  const prevBtn = container.querySelector('[data-carousel-prev]');
  const nextBtn = container.querySelector('[data-carousel-next]');
  
  let currentIndex = 0;

  function getCardWidth() {
    return cards[0].offsetWidth + parseFloat(getComputedStyle(cards[0]).marginRight || 0);
  }

  function updateCarousel() {
    const offset = currentIndex * getCardWidth();
    track.style.transform = `translateX(-${offset}px)`;
    cards.forEach((card, i) => card.classList.toggle('active', i === currentIndex));
    dots.forEach((dot, i) => dot.classList.toggle('active', i === currentIndex));
  }

  function goTo(index) {
    if (index < 0) index = cards.length - 1;
    if (index >= cards.length) index = 0;
    currentIndex = index;
    updateCarousel();
  }

  prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn.addEventListener('click', () => goTo(currentIndex + 1));
  dots.forEach(dot => dot.addEventListener('click', () => goTo(parseInt(dot.dataset.dotIndex))));

  let autoSlide = true;
  let interval = setInterval(() => { if (autoSlide) goTo(currentIndex + 1); }, 5000);

  container.addEventListener('mouseenter', () => autoSlide = false);
  container.addEventListener('mouseleave', () => autoSlide = true);

  let startX = 0;
  container.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  container.addEventListener('touchend', e => {
    const delta = e.changedTouches[0].clientX - startX;
    if (delta > 50) goTo(currentIndex - 1);
    if (delta < -50) goTo(currentIndex + 1);
  });

  window.addEventListener('resize', updateCarousel);
  updateCarousel();
})();
</script>
{% endjavascript %}



{% schema %}
{
  "name": "Reviews Carousel",
  "settings": [
    {
      "type": "text",
      "id": "review_heading",
      "label": "Review Heading",
      "default": "Our Features"
    },
    {
      "type": "textarea",
      "id": "review_body",
      "label": "Review Section Body",
      "default": "Default"
    }

  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Body"
        },
        {
          "type": "text",
          "id": "reviewer",
          "label": "Reviewer Name"
        },
        {
          "type": "text",
          "id": "school",
          "label": "School Name"
        },
        {
          "type": "image_picker",
          "id": "school_logo",
          "label": "School Logo"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Reviews Carousel",
      "category": "Testimonials"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.review_heading h2{
    font-family: 'Poppins', sans-serif;
    font-size: 29px;
    font-weight: 800;
    color: #1F2443;
}

.review_body{
    font-family: 'Roboto', sans-serif;
    font-size: 20px;
    color: #1F2443;
}
.review-carousel-container {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    align-items: center;
    margin: 0 auto;
    background: #EAF3FB;
}

.review-track {
    display: flex;
    transition: transform 0.4s ease;
}

.review-card {
    flex: 0 0 33.3333%;
    padding: 1rem;
    box-sizing: border-box;
    border: 2px solid #2877C2;
    border-radius: 15px;
    margin-right: 20px;
    text-align: left;
    transition: all 0.3s ease;
    height: 400px;
    max-width: 350px;
    color: #1F2443;
}

.review-card.active {
    border-color: #2877C2;
    background-color: #2877C2;
    color: #ffffff;
}

.review-card.active .stars-icon {
    color: #ffffff;
}

.stars {
    color: #007aff;
    margin-bottom: 20px;
    margin-top: 10px;
}


.review-title {
    font-family: 'Roboto', sans-serif;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 0.25rem;
}

.review-body {
    font-family: 'Roboto', sans-serif;
    font-size: 18px;
    margin-bottom: 0.5rem;
}

.review-footer {
    display: flex;
    align-items: left;
    justify-content: left;
    gap: 0.75rem;
    margin-top: 1rem;
}

.school-logo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
}

.review-meta {
    text-align: left;
}

.review-meta .name {
    font-weight: bold;
}

  .review-meta .school {
    font-style: italic;
    font-size: 0.85rem;
  }

  .carousel-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .carousel-dots span {
    width: 10px;
    height: 10px;
    background: #ccc;
    border-radius: 50%;
    margin: 0 4px;
    cursor: pointer;
  }

  .carousel-dots span.active {
    background: #007aff;
  }

  .arrow-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .carousel-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-top: 1rem;
}

.arrow-btn {
  background: none;
  border: none;
  font-size: 1.75rem;
  cursor: pointer;
  color: #007aff;
  padding: 0 0.5rem;
}
{% endstylesheet %}

<div class="review-carousel-container" data-reviews-carousel>
   <h2 class="review-heading">{{ section.settings.review_heading }}</h2>
   <p class="review-body">{{ section.settings.review_body }}</p>

  <div class="review-track">
    {% for block in section.blocks %}
      <div class="review-card{% if forloop.index == 2 %} active{% endif %}">
        <div class="stars">
